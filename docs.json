{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Brightweir Triage",
  "colors": {
    "primary": "#1F5F8B",
    "light": "#5FA8D3",
    "dark": "#17496B"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "banner": {
    "content": "Demo site: Brightweir Labs is a fictional company. Built by Jason Helfenbaum ([ClicKnowledge](https://clicknowledge.com)) to show a docs-as-code pipeline.",
    "dismissible": true
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["quickstart", "architecture"]
      },
      {
        "group": "API reference",
        "openapi": "api-reference/openapi.yaml",
        "pages": [
          "api-reference/introduction",
          "POST /v1/tickets/classify",
          "POST /v1/tickets/{ticket_id}/draft-reply",
          "GET /v1/models",
          "POST /v1/feedback"
        ]
      },
      {
        "group": "Product",
        "pages": ["datasheet"]
      },
      {
        "group": "Docs operations",
        "pages": ["runbook"]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "simple"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Source on GitHub",
        "href": "https://github.com/ClicKnowledge/docs-as-code-demo"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ClicKnowledge/docs-as-code-demo"
    }
  }
}
